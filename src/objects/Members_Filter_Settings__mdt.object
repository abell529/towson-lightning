<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>7Summits Members Filter settings</description>
    <fields>
        <fullName>Filter_List_Limit__c</fullName>
        <defaultValue>50</defaultValue>
        <description>Apex query list limit</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Limit the returned pick list values</inlineHelpText>
        <label>Filter List Limit</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Send_Email_Notification__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Send an email notification when the batch job completes to the job creator.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Check this to send an email notification when the batch job completes to the job creator.</inlineHelpText>
        <label>Send Email Notification</label>
        <type>Checkbox</type>
    </fields>
    <label>Members Filter Setting</label>
    <pluralLabel>Members Filter Settings</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
