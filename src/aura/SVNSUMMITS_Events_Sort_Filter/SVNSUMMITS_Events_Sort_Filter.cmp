<aura:component access="global"
                controller="SVNSUMMITS_EventListController">

    <ltng:require styles="{!$Resource.SVNSUMMITS_Event_SemanticUI + '/SemanticUI/dist/components/dropdown.min.css'}"
		scripts="{!join(',',
    			$Resource.SVNSUMMITS_Event_Resource + '/EventsResource/LightningLookup/jquery-2.1.1.min.js',
    			$Resource.SVNSUMMITS_Event_SemanticUI + '/SemanticUI/dist/components/dropdown.min.js'
                 )}"
        afterScriptsLoaded="{!c.doInit}" />

    <!--<aura:handler name="init" value="{!this}" action="{!c.setSortOption}"/>-->

    <aura:attribute name="sortBy" type="String" default="Upcoming" access="global"/>
    <aura:attribute name="listViewMode" type="String" default="List" access="global"/>
    <aura:attribute name="sortByUpcoming" type="String" default="{!$Label.c.ss_evt_label_Upcoming}" access="global"/>
    <aura:attribute name="sortByAttendance" type="String" default="{!$Label.c.ss_evt_label_TopAttendance}" access="global"/>
    <aura:attribute name="sitePrefix" type="String"/>

    <div class="slds-form-element">
        <div class="slds-form-element__control">
            <div class="slds-select_container" id="label-holder"  data-TopAttendees="TopAttendees" data-Upcoming="Upcoming">

                <ui:inputSelect aura:id="SortSelect" label="Sort" class="slds-select"  value="{!v.sortBy}" change="{!c.setSortOption}">
                    <ui:inputSelectOption label="{!$Label.c.ss_evt_label_Upcoming}"  text="Upcoming"/>
                    <ui:inputSelectOption label="{!$Label.c.ss_evt_label_TopAttendance}"  text="TopAttendees"/>
                </ui:inputSelect>
                <!--<lightning:select label="{!v.sortByLabel}" name="SortSelect"  onchange="{!c.setSortOption}">
                    <option label="{!$Label.c.ss_evt_label_Upcoming}" value="Upcoming">{!$Label.c.ss_evt_label_Upcoming}</option>
                    <option label="{!$Label.c.ss_evt_label_TopAttendance}" value="TopAttendees">{!$Label.c.ss_evt_label_TopAttendance}</option>
                </lightning:select>-->

            </div>
        </div>
    </div>

</aura:component>