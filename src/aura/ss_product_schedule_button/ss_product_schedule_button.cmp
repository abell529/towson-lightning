<aura:component description="ss_product_schedule_button"
                extends="c:ss_product_base"
                controller="sc_listController"
                access="global">

    <aura:attribute name="iconName"         type="String"/>
    <aura:attribute name="productId"        type="String"  access="public"/>
    <aura:attribute name="productName"      type="String"  access="public"/>
    <aura:attribute name="unitPrice"        type="Decimal" access="public"/>
    <aura:attribute name="showQuantity"     type="Boolean" access="public"/>
    <aura:attribute name="quantity"         type="Integer" access="public" default="1"/>
    <aura:attribute name="optionsQuantity"  type="List" />
    <aura:attribute name="frequency"        type="String" default="Monthly"/>
    <aura:attribute name="nextPaymentDate"  type="Date"/>
    <aura:attribute name="finalPaymentDate" type="Date"/>
    <aura:attribute name="checkoutUrl"      type="String"  default="/7s-product-checkout" access="global"/>
    <aura:attribute type="Peak_Response" name="peakResponsePS"/>

    <aura:attribute name="buttonVariant"    type="String" default="brand"/>
    <aura:attribute name="buttonAdd"        type="String" default="{!$Label.c.ss_pc_button_schedule}"/>
    <aura:attribute name="buttonLabelAdd"   type="String" default="{!$Label.c.ss_pc_button_schedule}"/>
    <aura:attribute name="buttonLabelAdded" type="String" default="{!$Label.c.ss_pc_button_scheduled}"/>

    <aura:registerEvent name="addItemToCart" type="c:ss_cart_event"/>

    <lightning:layout multipleRows="true"
                      verticalAlign="center">

        <aura:if isTrue="{!v.showQuantity}">
            <lightning:layoutItem size="1"
                                  padding="around-small">
                <lightning:select aura:id="itemQuantity"
                                  name="itemQuantity"
                                  label="{!$Label.c.ss_pc_label_itemQuantity}"
                                  value="{!v.quantity}">
                    <aura:iteration items="{!v.optionsQuantity}" var="option">
                        <option value="{!option}"
                                text="{!option}"
                                selected="{!!v.quantity == option}">
                        </option>
                    </aura:iteration>
                </lightning:select>
            </lightning:layoutItem>
        </aura:if>
        <lightning:layoutItem size="3" padding="around-small">
            <lightning:select label="{!$Label.c.ss_pc_label_frequency}" name="Frequency" required="true" value="{!v.frequency}">
                <option value="Daily">Daily</option>
                <option value="Weekly">Weekly</option>
                <option value="Monthly">Monthly</option>
                <option value="Quarterly">Quarterly</option>
                <option value="Semi-annual">Semi-annual</option>
                <option value="Annual">Annual</option>
                <option value="Single">Single</option>
            </lightning:select>
        </lightning:layoutItem>
        <lightning:layoutItem size="3" padding="around-small">
            <lightning:input type="date"
                             aura:id="nxtdate"
                             label="{!$Label.c.ss_pc_label_next_payment_date}"
                             name="NextPaymentDate"
                             value="{!v.nextPaymentDate}"
                             required="true"/>
        </lightning:layoutItem>
        <lightning:layoutItem size="3" padding="around-small">
            <lightning:input type="date"
                             aura:id="finaldate"
                             label="{!$Label.c.ss_pc_label_final_payment_date}"
                             name="FinalPaymentDate"
                             value="{!v.finalPaymentDate}"/>
        </lightning:layoutItem>
        <lightning:layoutItem size="9" padding="around-small">
            <lightning:button onclick="{!c.addToSchedule}"
                              label="{!v.buttonAdd}"
                              title="{!$Label.c.ss_pc_tooltip_schedule}"
                              iconName="{!v.iconName}"
                              variant="{!v.buttonVariant}"/>
        </lightning:layoutItem>
    </lightning:layout>
</aura:component>
