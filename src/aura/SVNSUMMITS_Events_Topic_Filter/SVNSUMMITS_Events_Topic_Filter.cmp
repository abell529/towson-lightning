<aura:component controller="SVNSUMMITS_EventListController"
                implements="force:appHostable,flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes"
                access="global">

	<!--Static resource Section Start-->
	<ltng:require styles="{!join(',',
			$Resource.SVNSUMMITS_Event_SemanticUI + '/SemanticUI/dist/components/dropdown.min.css',
			$Resource.SVNSUMMITS_Event_SemanticUI + '/SemanticUI/dist/components/transition.min.css'
			)}"
	              scripts="{!join(',',
			              $Resource.SVNSUMMITS_Event_Resource + '/EventsResource/LightningLookup/jquery-2.1.1.min.js',
			              $Resource.SVNSUMMITS_Event_SemanticUI + '/SemanticUI/dist/components/dropdown.min.js',
			              $Resource.SVNSUMMITS_Event_SemanticUI + '/SemanticUI/dist/components/transition.min.js'
			              )}"
	              afterScriptsLoaded="{!c.doInit}"/>

	<!--Static resource Section End-->

	<!--Events Section Start-->
	<aura:registerEvent name="appEvent" type="c:SVNSUMMITS_Topic_Filter_Event"/>
	<!--Events Section End-->

	<!--Attributes Declaration Section Start-->
	<aura:attribute name="debugMode" type="Boolean" default="true" access="global"/>
	<aura:attribute name="values" type="Map" access="global"/>
	<aura:attribute name="filterLabel" type="String" default="Topics" access="global"/>
	<aura:attribute name="setTopicButtonLabel" type="String" default="{!$Label.c.ss_evt_label_SelectButtonLabel}" access="global"/>
	<aura:attribute name="clearButtonLabel" type="String" default="Clear" access="global"/>
	<!--Attributes Declaration Section End-->

	<!--Topics and Values Section Start-->
	<div class="form-element__group">
		<div class="slds-wrap slds-grid slds-p-top--medium">
                <lightning:select aura:id="filterByTopic"
                                  label="{!v.filterLabel}" onchange="{!c.setTopic}">
                    <ui:inputSelectOption text="All" label="All" value="All"/>
                    <aura:iteration items="{!v.values}" indexVar="key" var="item">
                        <ui:inputSelectOption text="{!item.key}" label="{!item.value}"/>
                    </aura:iteration>
                </lightning:select>
		</div>
	</div>
	<!--Topics and Values Section Start-->
</aura:component>