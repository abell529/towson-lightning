<aura:component controller="SVNSUMMITS_NewsController"
                access="global">

	<ltng:require styles="{!join(',',
					$Resource.SVNSUMMITS_News_SemanticUI + '/dist/components/form.min.css?v=2.1.8',
					$Resource.SVNSUMMITS_News_SemanticUI + '/dist/components/dropdown.min.css?v=2.1.8',
					$Resource.SVNSUMMITS_News_SemanticUI + '/dist/components/transition.min.css?v=2.1.7'
					)}"
			scripts="{!join(',',
					$Resource.SVNSUMMITS_News_SemanticUI + '/jquery-2.1.1.min.js',
					$Resource.SVNSUMMITS_News_SemanticUI + '/fullcalendar-2.6.1/moment.min.js',
					$Resource.SVNSUMMITS_News_SemanticUI + '/dist/components/form.min.js?v=2.1.8',
					$Resource.SVNSUMMITS_News_SemanticUI + '/dist/components/dropdown.min.js?v=2.1.8',
					$Resource.SVNSUMMITS_News_SemanticUI + '/dist/components/transition.min.js?v=2.1.7'
					)}"
			afterScriptsLoaded="{!c.doInit}"/>

	<aura:registerEvent name="appEvent" type="c:SVNSUMMITS_News_Author_Filter_Event"/>

	<aura:attribute name="values" type="Map" access="global"/>
	<aura:attribute name="placeHolderAuthor" type="String" default="{!$Label.c.ss_nws_placeholder_filterAuthor}"/>
	<aura:attribute name="selection" type="String" default="" access="public"/>

	<lightning:layout multipleRows="true"
	                  verticalAlign="end">
		<!--<lightning:layoutItem size="12"-->
		                      <!--class="slds-p-bottom&#45;&#45;xxx-small slds-text-color_weak">-->
				<!--{!$Label.c.ss_nws_label_filterAuthor}-->
		<!--</lightning:layoutItem>-->
		<lightning:layoutItem size="12">
			<lightning:select aura:id="filterByAuthor"
			                class="slds-input-select-multi fluid dropdown authorPicklist author"
			                value="{!v.selection}"
			                onchange="{!c.selectAuthor}"
			label="{!$Label.c.ss_nws_label_filterAuthor}">
                <ui:inputSelectOption text="All"
                                      label="All"/>
				<aura:iteration items="{!v.values}" var="item">
					<ui:inputSelectOption text="{!item.key}"
					                      label="{!item.value}"/>
				</aura:iteration>
			</lightning:select>
		</lightning:layoutItem>
	</lightning:layout>
</aura:component>