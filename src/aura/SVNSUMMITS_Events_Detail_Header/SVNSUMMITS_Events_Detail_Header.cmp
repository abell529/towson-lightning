<aura:component controller="SVNSUMMITS_EventListController"
                access="global" implements="force:appHostable,flexipage:availableForAllPageTypes,forceCommunity:availableForAllPageTypes,force:hasRecordId,force:hasSObjectName">

	<ltng:require scripts="{!join(',',
            $Resource.SVNSUMMITS_Event_Resource + '/EventsResource/LightningLookup/jquery-2.1.1.min.js',
            $Resource.SVNSUMMITS_Event_Resource + '/EventsResource/jQuery/jquery-ui.js',
            $Resource.SVNSUMMITS_Event_Custom + '/EventsCustom/moment-timezone-with-data.min.js')}"/>


   <aura:handler name="init" value="{!this}" action="{!c.fetchUrl}"/>

    <aura:attribute name="debugMode" type="Boolean" default="false" access="global"/>
    <aura:attribute name="wrappedEventsObj" type="String" access="global"/>
    <aura:attribute name="recordId" type="String" default="" access="global"/>
    <aura:attribute name="exploreOtherEvents" type="String" default="{!$Label.c.ss_evt_label_ExploreOther}" access="global"/>
    <aura:attribute name="exploreOtherEventsURL" type="String" access="global" default="/events-list/"/>
    <aura:attribute name="sitePath" type="String" access="global"/>

    <div class="slds-grid slds-wrap">
    	<div class="slds-col--padded slds-size--1-of-1 fontHeader">
            {!v.wrappedEventsObj}

         </div>
         <div class="slds-col--padded slds-size--1-of-1 expCss">{!$Label.c.ss_evt_label_ExploreOther}&nbsp;
             <a href="{!v.sitePath + v.exploreOtherEventsURL}">{!$Label.c.ss_evt_label_Events}</a>
         </div>
    </div>
</aura:component>