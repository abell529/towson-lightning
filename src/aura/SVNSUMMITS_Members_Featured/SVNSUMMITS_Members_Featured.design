<design:component label="7S Members Featured">
	<design:attribute name="featuredTitle"
	                  label="TRANSLATABLE-Featured Members Title (hover over info icon)"
	                  description="Title for Featured Members.  This text is set up to be translated by referencing ss_label_Explore_Featured_Members.  If you change it to regular text it will display fine but NOT be translatable. Clearing out ALL text will restore default.  To display nothing set text to 'none'(no quotes)."/>
	<design:attribute name="featuredDescription"
	                  label="TRANSLATABLE-Featured Members Description (hover over info icon)"
	                  description="Description of Featured Members.This text is set up to be translated by referencing ss_label_Featured_Description.  If you change it to regular text it will display fine but NOT be translatable. Clearing out ALL text will restore default.  To display nothing set text to 'none'(no quotes)."/>
	<design:attribute name="recordNickName1"
	                  label="Record NickName 1"
	                  description="Enter Record NickName of First Member"/>
	<design:attribute name="recordNickName2"
	                  label="Record NickName 2"
	                  description="Enter Record NickName of Second Member"/>
	<design:attribute name="recordNickName3"
	                  label="Record NickName 3"
	                  description="Enter Record NickName of Third Member"/>
	<design:attribute name="recordNickName4"
	                  label="Record NickName 4"
	                  description="Enter Record NickName of Fourth Member"/>
	<design:attribute name="recordNickName5"
	                  label="Record NickName 5"
	                  description="Enter Record NickName of Fifth Member"/>
	<design:attribute name="recordNickName6"
	                  label="Record NickName 6"
	                  description="Enter Record NickName of Sixth Member"/>
	<design:attribute name="recordNickName7"
	                  label="Record NickName 7"
	                  description="Enter Record NickName of Seventh Member"/>
	<design:attribute name="recordNickName8"
	                  label="Record NickName 8"
	                  description="Enter Record NickName of Eighth Member"/>
	<design:attribute name="allMembersButtonText"
	                  label="TRANSLATABLE-Text for All Members Button (hover over info icon)"
	                  description="Text for link to list view page.  This text is set up to be translated by referencing ss_label_All_Members.  If you change it to regular text it will display fine but NOT be translatable. Clearing out ALL text will restore default."/>
	<design:attribute name="allMembersUrl"
	                  label="Link to All Members"
	                  description="Url to redirect to the member list view page"/>
	<design:attribute name="membersURL"
	                  label="Link to Member Detail"
	                  description=""/>
	<design:attribute name="displayTitle"
	                  label="Display Member Title"
	                  description="Check box for enable and disable display of user title "
	                  default="true"/>
	<design:attribute name="displayPhone"
	                  label="Display Member Phone Number"
	                  description="Check box for enable and disable display of user Phone Number "
	                  default="true"/>
	<design:attribute name="clickToCall"
	                  label="Enable click-to-call"
	                  description="If enabled, the user can click on the phone number to launch the Phone app on the device"/>
	<design:attribute name="displayEmail"
	                  label="Display Member Email Address"
	                  description="Check box for enable and disable display of user Email Address "
	                  default="true"/>

	<design:attribute name="customClass"
	                  label="Custom Class/es to add to this instance"
	                  description="Class or classes listed here are added to the Featured Members wrapper div"/>
	<design:attribute name="customId"
	                  label="Custom ID to add to this instance"
	                  description="ID set here will be added to the list wrapper div"/>
</design:component>